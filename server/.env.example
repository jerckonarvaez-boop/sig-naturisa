# Copia este archivo como .env y ajusta los valores
PORT=4000
DB_PATH=data/sig.db
CORS_ORIGIN=http://localhost:5173

# Inicio de sesión con credenciales corporativas de Naturisa
AUTH_URL=https://gateway.naturisa.com.ec/bff/web/portal/security/api/auth
# Código de aplicación que exige el servicio (por defecto, el del Portal de Compras)
AUTH_APP_CODE=cbe2cd96-cdc5-4bd9-bc6e-b7d6a822e656
# Clave para firmar las sesiones (obligatoria en producción; usa un texto largo y aleatorio)
SESSION_SECRET=
# Solo para desarrollo: true = no pedir inicio de sesión
AUTH_DISABLED=false
